{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset *)",
      "Bash(cmake --build *)",
      "Bash(cmake --workflow *)",
      "Bash(ctest *)",
      "Bash(clang-tidy *)",
      "Bash(clang-format *)",
      "Bash(verify-env)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Read(./.env*)",

      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",

      "Edit(/src/core/**)",
      "Edit(/include/trackpipe/core/**)",
      "Edit(/src/sources/v4l2/**)",
      "Edit(/src/queue/**)",
      "Edit(/src/inference/tensorrt/**)",
      "Edit(/src/tracking/**)",
      "Edit(/src/protocol/**)"
    ]
  }
}
